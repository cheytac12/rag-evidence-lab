# Copy this file to .env and configure one provider to enable generation and LLM evaluation.
# Gemini is the recommended free-tier option; quota and Google data-use terms apply.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# To use OpenAI instead, set LLM_PROVIDER=openai and fill these values.
OPENAI_API_KEY=
OPENAI_MODEL=
